# Public template: copy to .env and configure ONE inference provider.
# Model credentials remain on the controller host, outside agent computers.
RESEARCH_PROVIDER=bedrock
RESEARCH_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
RESEARCH_AWS_REGION=ap-south-2
RESEARCH_AWS_PROFILE=
RESEARCH_BEDROCK_API_KEY=
# Alternative: RESEARCH_PROVIDER=openai-compatible
# Use your provider's model ID and HTTPS base URL (including /v1 if needed).
RESEARCH_BASE_URL=
RESEARCH_API_KEY=
RESEARCH_TEMPERATURE=0.2
# Optional USD rates per million tokens; blank means cost is unknown.
RESEARCH_INPUT_PRICE=
RESEARCH_OUTPUT_PRICE=
